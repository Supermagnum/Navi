{
  "version": 8,
  "name": "Navi Protomaps Light (offline)",
  "metadata": {
    "navi:style": "protomaps-light",
    "navi:note": "Placeholders __PMTILES_URL__, __SPRITE__, __GLYPHS__ are rewritten at runtime."
  },
  "sources": {
    "protomaps": {
      "type": "vector",
      "url": "__PMTILES_URL__",
      "attribution": "© OpenStreetMap © Protomaps"
    }
  },
  "sprite": "__SPRITE__",
  "glyphs": "__GLYPHS__/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f8f4f0" }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "earth",
      "paint": { "fill-color": "#f8f4f0" }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landcover",
      "paint": {
        "fill-color": [
          "match",
          ["get", "kind"],
          "grassland", "#d8e8c8",
          "barren", "#f0e8d8",
          "urban_area", "#e8e0d8",
          "farmland", "#e8f0d0",
          "glacier", "#e8f0f8",
          "scrub", "#d0e0b8",
          "forest", "#a8d090",
          "#d8e8c8"
        ],
        "fill-opacity": 0.6
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "paint": {
        "fill-color": [
          "match",
          ["get", "kind"],
          "park", "#c8e0b0",
          "forest", "#a8d090",
          "wood", "#a8d090",
          "scrub", "#d0e0b8",
          "grass", "#d8e8c8",
          "grassland", "#d8e8c8",
          "meadow", "#d8e8c8",
          "cemetery", "#c8d8b8",
          "hospital", "#f0d8d8",
          "school", "#f0e8c8",
          "industrial", "#d8d0c8",
          "#e8e0d0"
        ],
        "fill-opacity": 0.5
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "water",
      "filter": [
        "match",
        ["geometry-type"],
        ["Polygon", "MultiPolygon"],
        true,
        false
      ],
      "paint": { "fill-color": "#80b0d0" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "protomaps",
      "source-layer": "water",
      "filter": [
        "match",
        ["geometry-type"],
        ["LineString", "MultiLineString"],
        true,
        false
      ],
      "paint": {
        "line-color": "#80b0d0",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 14, 2.5]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "buildings",
      "minzoom": 13,
      "paint": { "fill-color": "#d8d0c8", "fill-opacity": 0.7 }
    },
    {
      "id": "roads_minor",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": ["in", ["get", "kind_detail"], ["literal", ["residential", "service", "unclassified", "living_street", "tertiary", "secondary"]]],
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 16, 4]
      }
    },
    {
      "id": "roads_major",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": ["in", ["get", "kind_detail"], ["literal", ["primary", "trunk", "motorway", "motorway_link", "trunk_link", "primary_link"]]],
      "paint": {
        "line-color": "#f0d090",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1, 14, 6]
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "protomaps",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#a09080",
        "line-width": 0.8,
        "line-dasharray": [2, 1]
      }
    },
    {
      "id": "places",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "places",
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 10, 10, 14]
      },
      "paint": {
        "text-color": "#403020",
        "text-halo-color": "#f8f4f0",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "roads_label_motorway",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 13,
      "filter": [
        "all",
        ["match", ["get", "kind_detail"], ["motorway", "motorway_link"], true, false],
        ["any", ["has", "name"], ["has", "ref"]]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name"], ["get", "ref"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12,
        "text-max-angle": 30
      },
      "paint": {
        "text-color": "#303030",
        "text-halo-color": "#f8f4f0",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "roads_label_secondary",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 14,
      "filter": [
        "all",
        ["has", "name"],
        ["match", ["get", "kind_detail"], ["secondary", "secondary_link"], true, false]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12,
        "text-max-angle": 30
      },
      "paint": {
        "text-color": "#403020",
        "text-halo-color": "#f8f4f0",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "roads_label_major",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 15,
      "filter": [
        "all",
        ["has", "name"],
        [
          "match",
          ["get", "kind_detail"],
          ["primary", "primary_link", "tertiary", "tertiary_link", "trunk", "trunk_link"],
          true,
          false
        ]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12,
        "text-max-angle": 30
      },
      "paint": {
        "text-color": "#403020",
        "text-halo-color": "#f8f4f0",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "roads_label_minor",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 15,
      "filter": [
        "all",
        ["has", "name"],
        [
          "match",
          ["get", "kind_detail"],
          [
            "residential",
            "unclassified",
            "service",
            "living_street",
            "road",
            "pedestrian",
            "track",
            "path",
            "cycleway",
            "footway"
          ],
          true,
          false
        ]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "text-max-angle": 30
      },
      "paint": {
        "text-color": "#504030",
        "text-halo-color": "#f8f4f0",
        "text-halo-width": 1.0
      }
    },
    {
      "id": "pois",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "pois",
      "minzoom": 16,
      "filter": [
        "all",
        [">=", ["zoom"], ["coalesce", ["get", "min_zoom"], 0]],
        [
          "match",
          ["get", "kind"],
          [
            "school",
            "university",
            "college",
            "kindergarten",
            "fuel",
            "charging_station",
            "convenience",
            "supermarket",
            "grocery",
            "bus_stop",
            "parking",
            "attraction",
            "museum",
            "cafe",
            "restaurant",
            "fast_food",
            "hospital",
            "pharmacy",
            "library",
            "post_office",
            "toilets",
            "drinking_water",
            "bench",
            "playground",
            "park",
            "zoo",
            "theatre",
            "cinema",
            "hotel",
            "peak",
            "hill"
          ],
          true,
          false
        ]
      ],
      "layout": {
        "icon-image": [
          "match",
          ["get", "kind"],
          "school", "school",
          "university", "university",
          "college", "university",
          "kindergarten", "school",
          "cafe", "cafe",
          "restaurant", "restaurant",
          "fast_food", "fast_food",
          "bus_stop", "bus_stop",
          "convenience", "convenience",
          "supermarket", "supermarket",
          "grocery", "supermarket",
          "attraction", "attraction",
          "museum", "museum",
          "library", "library",
          "post_office", "post_office",
          "toilets", "toilets",
          "drinking_water", "drinking_water",
          "bench", "bench",
          "park", "park",
          "playground", "park",
          "zoo", "zoo",
          "theatre", "theatre",
          "cinema", "theatre",
          "peak", "peak",
          "hill", "peak",
          "fuel", "townspot",
          "charging_station", "townspot",
          "parking", "townspot",
          "hospital", "townspot",
          "pharmacy", "townspot",
          "hotel", "townspot",
          "townspot"
        ],
        "icon-size": 1.0,
        "icon-allow-overlap": true,
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "text-optional": true,
        "text-allow-overlap": false,
        "text-offset": [0, 1.1],
        "text-anchor": "top"
      },
      "paint": {
        "text-color": "#303030",
        "text-halo-color": "#f8f4f0",
        "text-halo-width": 1.0
      }
    }
  ]
}
