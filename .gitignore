# Rust / Cargo
/target/
core/target/
**/target/

# Local non-root WebKitGTK headers (see docs/build-linux.md)
.deps-prefix/

# Android / Gradle
.gradle/
**/build/
app/build/
local.properties
*.iml
.idea/
*.apk
*.aab
# Sideload copy committed for testers (see README).
!compiled/
!compiled/*.apk
app/keystore/
*.jks
*.keystore
# Built by scripts/build-android-native.sh — do not commit rebuilt copies.
app/src/main/jniLibs/**/*.so
# Built by scripts/build-plugin-wasm.sh — never commit guest binaries.
app/src/main/assets/plugins/
# Built by scripts/stage-comaps-data-assets.sh from the CoMaps pin (not World.mwm).
app/src/main/assets/comaps-data/
# Accidental / local CoMaps clone (use scripts/fetch-comaps.sh + pin JSON).
third_party/comaps/
# Large Phase 3 device route artifacts (adb pull); do not commit GeoJSON dumps.
test-artifacts/mwm-phase3/
test-artifacts/mwm-phase4/
# Phase 6 on-device acceptance output (screenshots, logs, perf captures).
test-artifacts/phase6/
test-artifacts/phase6a/
test-artifacts/phase6b/
# Kotlin/IDE incremental compile scratch
.kotlin/

# Local F-Droid buildability check workspace (not for commit)
tools/fdroid-check/work/
tools/fdroid-check/logs/
tools/fdroid-check/fdroidserver/

# OS
.DS_Store

# Local machine-only debug snapshots (emulator GPU/context, etc.)
/local/
# Raw pulled location-diag sessions (may contain real coordinates / device ids).
# Anonymise with tools/anonymise_location_diag.py before committing a fixture.
/local/location-diag-raw/
.fu64-work/
.fu66-work/

# Integration fixtures (large)
core/target/integration-fixtures/*.pbf
core/target/integration-fixtures/*.tar
core/target/integration-fixtures/elevation/

# Allow documentation images (including nested HUD / bearing folders)
!docs/images/
!docs/images/**/
!docs/images/**/*.png

# Scratch / intermediate screencaps (do not publish)
docs/images/tmp/
docs/images/tmp_*.png
.git-status-report.txt

# Local reference GeoJSON routes (ORS / external ECO-off baselines)
/geojson-routes/

diff-repport.md
plugins/right-to-roam-camping/pkg/
.packs/

# Generated bytecode and local DATEX campaign inject (not source).
__pycache__/
scripts/__pycache__/
.campaign-datex/

# User RepeaterBook downloads. Never commit.
testdata/cat/local/

# User-downloaded RepeaterBook KML exports. Must never be committed.
/klm/
