# Rust / Cargo
/target/
core/target/
**/target/

# Local non-root WebKitGTK headers (see docs/build-linux.md)
.deps-prefix/

# Android / Gradle
.gradle/
**/build/
app/build/
local.properties
*.iml
.idea/
*.apk
*.aab
# Sideload copy committed for testers (see README).
!compiled/
!compiled/*.apk
app/keystore/
*.jks
*.keystore
# Built by scripts/build-android-native.sh — do not commit rebuilt copies.
app/src/main/jniLibs/**/*.so
# Kotlin/IDE incremental compile scratch
.kotlin/

# Local F-Droid buildability check workspace (not for commit)
tools/fdroid-check/work/
tools/fdroid-check/logs/
tools/fdroid-check/fdroidserver/

# OS
.DS_Store

# Local machine-only debug snapshots (emulator GPU/context, etc.)
/local/

# Integration fixtures (large)
core/target/integration-fixtures/*.pbf
core/target/integration-fixtures/*.tar
core/target/integration-fixtures/elevation/

# Allow documentation images (including nested HUD / bearing folders)
!docs/images/
!docs/images/**/
!docs/images/**/*.png

# Scratch / intermediate screencaps (do not publish)
docs/images/tmp/
docs/images/tmp_*.png
.git-status-report.txt

diff-repport.md
