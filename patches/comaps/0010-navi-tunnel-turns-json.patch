 namespace
 {
+/// True when the type path is highway/*/tunnel (not bridge).
+bool IsHighwayTunnelType(uint32_t type)
+{
+  if (ftype::GetLevel(type) != 3)
+    return false;
+
+  ClassifObject const * p = classif().GetRoot()->GetObject(ftype::GetValue(type, 0));
+  if (!p || p->GetName() != "highway")
+    return false;
+
+  p = p->GetObject(ftype::GetValue(type, 1));
+  if (!p)
+    return false;
+
+  p = p->GetObject(ftype::GetValue(type, 2));
+  return p && p->GetName() == "tunnel";
+}
+
+/// Look up highway/*/tunnel on the feature behind a route segment.
+bool IsTunnelSegment(FrozenDataSource & dataSource,
+                     std::shared_ptr<routing::NumMwmIds> const & numMwmIds,
+                     routing::Segment const & seg,
+                     std::map<std::pair<routing::NumMwmId, uint32_t>, bool> & cache)
+{
+  if (!numMwmIds || !seg.IsRealSegment())
+    return false;
+  auto const key = std::make_pair(seg.GetMwmId(), seg.GetFeatureId());
+  if (auto const it = cache.find(key); it != cache.end())
+    return it->second;
+
+  bool isTunnel = false;
+  try
+  {
+    auto const handle = dataSource.GetMwmHandleByCountryFile(numMwmIds->GetFile(seg.GetMwmId()));
+    if (handle.IsAlive())
+    {
+      FeaturesLoaderGuard guard(dataSource, handle.GetId());
+      if (auto ft = guard.GetFeatureByIndex(seg.GetFeatureId()))
+      {
+        feature::TypesHolder types(*ft);
+        for (uint32_t t : types)
+        {
+          if (IsHighwayTunnelType(t))
+          {
+            isTunnel = true;
+            break;
+          }
+        }
+      }
+    }
+  }
+  catch (std::exception const &)
+  {
+    // Feature lookup must never abort the router (std::length_error -> SIGABRT).
+    isTunnel = false;
+  }
+  catch (...)
+  {
+    isTunnel = false;
+  }
+  cache.emplace(key, isTunnel);
+  return isTunnel;
+}
