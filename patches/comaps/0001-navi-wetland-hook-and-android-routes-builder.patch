   routeResult.m_followedPolyline = route.GetFollowedPolyline();
 
+  // Failed routes have empty subroute attrs — skip turns/elev (CHECKs abort).
+  if (resultCode != RouterResultCode::NoError)
+  {
+    result.m_routes.emplace_back(std::move(routeResult));
+    return result;
+  }
+
+  // Navi: export display turns for guidance / voice (locale from settings or en).
+  // Instruction text is filled by Navi (Rust); export turn types + ferry flag.
+  {
+    std::string locale = "en";
+    settings::Get("locale", locale);
+    auto const steps = route.GetTurnsForDisplay(locale);
+    auto const & segs = route.GetRouteSegments();
+    std::ostringstream json;
+    json << '[';
+    auto escape = [](std::string const & in, std::ostringstream & out) {
+      for (char c : in)
+      {
+        if (c == '\\' || c == '"')
+          out << '\\';
+        else if (c == '\n')
+        {
+          out << "\\n";
+          continue;
+        }
+        out << c;
+      }
+    };
+    // m_index is polyline point index (= segment index + 1). Scan the
+    // segments belonging to each step (prev point .. this point) so a ferry
+    // leg is tagged even when the turn point itself sits on a non-ferry road.
+    size_t prevPoint = 0;
+    for (size_t i = 0; i < steps.size(); ++i)
+    {
+      auto const & s = steps[i];
+      if (i)
+        json << ',';
+      size_t const endPoint = std::min(static_cast<size_t>(s.m_index), segs.size());
+      bool isFerry = false;
+      for (size_t si = prevPoint; si < endPoint; ++si)
+      {
+        if (segs[si].GetRoadTypes().Has(routing::RoutingOptions::Option::Ferry))
+        {
+          isFerry = true;
+          break;
+        }
+      }
+      prevPoint = endPoint;
+      json << '{'
+          << "\"index\":" << s.m_index << ','
+          << "\"sequence\":" << s.m_sequence << ','
+          << "\"exit_num\":" << s.m_exitNum << ','
+          << "\"dist_m\":" << s.m_distMeters << ','
+          << "\"turn\":\"" << DebugPrint(s.m_turn) << "\","
+          << "\"ped_turn\":\"" << DebugPrint(s.m_pedestrianTurn) << "\","
+          << "\"is_ferry\":" << (isFerry ? "true" : "false") << ','
+          << "\"street\":\"";
+      escape(s.m_toRoad.m_name, json);
+      json << "\",\"ref\":\"";
+      escape(s.m_toRoad.m_ref, json);
+      json << "\",\"destination\":\"";
+      escape(s.m_toRoad.m_destination, json);
+      json << "\"}";
+    }
+    json << ']';
+    routeResult.m_turnsJson = json.str();
+  }
+
+  // Navi: CoMaps altitudes + optional EL02 sidecar overrides → ascent/descent
+  // and per-point profile (side-by-side comaps vs effective).
+  {
+    geometry::Altitudes alts;
+    route.GetAltitudes(alts);
+    auto const & elevSegs = route.GetRouteSegments();
+    double ascentComaps = 0.0;
+    double descentComaps = 0.0;
+    double ascent = 0.0;
+    double descent = 0.0;
+    std::ostringstream ej;
+    ej << "{\"comaps_ascent_m\":";
+    // points first into a buffer so we can prefix totals
+    std::ostringstream pts;
+    pts << '[';
+    std::vector<double> effective;
+    effective.reserve(alts.size());
+    for (size_t i = 0; i < alts.size(); ++i)
+    {
+      if (i)
+        pts << ',';
+      auto const a = alts[i];
+      bool const comapsOk = a != geometry::kInvalidAltitude;
+      double comapsM = comapsOk ? static_cast<double>(a) : 0.0;
+      double eleM = comapsM;
+      char const * source = "comaps";
+      bool overrideOk = false;
+      auto tryOverride = [&](routing::Segment const & seg, uint32_t pointIdx) {
+        if (!m_numMwmIds || seg.GetMwmId() == routing::kFakeNumMwmId)
+          return;
+        auto const & cfile = m_numMwmIds->GetFile(seg.GetMwmId());
+        int32_t dm = 0;
+        if (navi_spike::WetlandSidecar::ElevationOverride(cfile.GetName().c_str(),
+                                                          seg.GetFeatureId(), pointIdx, dm))
+        {
+          // Only accept overrides that stay within a sane band of CoMaps altitude
+          // when both exist (guards residual index mismatches).
+          double const cand = static_cast<double>(dm) / 10.0;
+          if (!comapsOk || std::fabs(cand - comapsM) <= 75.0)
+          {
+            eleM = cand;
+            source = "sidecar";
+            overrideOk = true;
+          }
+        }
+      };
+      // altitudes[0] = subroute start; altitudes[i+1] = end of elevSegs[i]
+      if (i > 0 && i - 1 < elevSegs.size())
+      {
+        auto const & seg = elevSegs[i - 1].GetSegment();
+        tryOverride(seg, seg.GetSegmentIdx() + 1);
+      }
+      else if (i == 0 && !elevSegs.empty())
+      {
+        auto const & seg = elevSegs.front().GetSegment();
+        tryOverride(seg, seg.GetSegmentIdx());
+      }
+      if (!comapsOk && !overrideOk)
+      {
+        pts << "null";
+        effective.push_back(std::numeric_limits<double>::quiet_NaN());
+      }
+      else
+      {
+        if (!comapsOk)
+          source = "sidecar";
+        pts << "{\"ele_m\":" << static_cast<int>(std::lround(eleM))
+            << ",\"ele_comaps_m\":";
+        if (comapsOk)
+          pts << static_cast<int>(a);
+        else
+          pts << "null";
+        pts << ",\"source\":\"" << source << "\"}";
+        effective.push_back(eleM);
+      }
+      if (i > 0 && comapsOk && alts[i - 1] != geometry::kInvalidAltitude)
+      {
+        double const d = static_cast<double>(alts[i] - alts[i - 1]);
+        if (d > 0)
+          ascentComaps += d;
+        else
+          descentComaps += -d;
+      }
+      if (i > 0 && !std::isnan(effective[i]) && !std::isnan(effective[i - 1]))
+      {
+        double const d = effective[i] - effective[i - 1];
+        if (d > 0)
+          ascent += d;
+        else
+          descent += -d;
+      }
+    }
+    pts << ']';
+    ej << ascentComaps << ",\"comaps_descent_m\":" << descentComaps
+       << ",\"ascent_m\":" << ascent << ",\"descent_m\":" << descent
+       << ",\"points\":" << pts.str() << '}';
+    routeResult.m_ascentM = ascent;
+    routeResult.m_descentM = descent;
+    routeResult.m_elevationJson = ej.str();
+  }
+  // Mode is logged from IndexRouter; approximate from great-circle for the ABI.
+  {
+    auto const from = params.m_checkpoints.GetPointFrom();
+    auto const to = params.m_checkpoints.GetPointTo();
+    double const distM = ms::DistanceOnEarth(mercator::ToLatLon(from), mercator::ToLatLon(to));
+    // Mirror AreMwmsNear fallback threshold (300 km) when neighbour test unknown here.
+    routeResult.m_routerMode = (distM < 300000.0) ? "Joints(likely)" : "LeapsOnly(likely)";
+  }
+
   result.m_routes.emplace_back(std::move(routeResult));
 
   return result;
