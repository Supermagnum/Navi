diff --git a/libs/routing/navi_wetland_cost.cpp b/libs/routing/navi_wetland_cost.cpp
new file mode 100644
index 000000000..832a77e15
--- /dev/null
+++ b/libs/routing/navi_wetland_cost.cpp
@@ -0,0 +1,49 @@
+#include "routing/navi_wetland_cost.hpp"
+
+namespace navi_spike
+{
+namespace
+{
+WetlandLookupFn g_lookup = nullptr;
+ElevationLookupFn g_elevLookup = nullptr;
+bool g_bikeEnabled = false;
+constexpr double kSoftMult = 5.0;
+constexpr double kHardMult = 1.0e6;
+}  // namespace
+
+void WetlandSidecar::SetLookup(WetlandLookupFn fn) { g_lookup = fn; }
+
+bool WetlandSidecar::Enabled() { return g_lookup != nullptr; }
+
+void WetlandSidecar::SetBikeEnabled(bool enabled) { g_bikeEnabled = enabled; }
+
+bool WetlandSidecar::BikeEnabled() { return g_bikeEnabled && Enabled(); }
+
+WetlandClass WetlandSidecar::Lookup(uint32_t featureId, uint32_t segmentIdx, bool forward)
+{
+  if (!g_lookup)
+    return WetlandClass::None;
+  return g_lookup(featureId, segmentIdx, forward);
+}
+
+double WetlandSidecar::CostMultiplier(WetlandClass c)
+{
+  switch (c)
+  {
+  case WetlandClass::SoftAvoid: return kSoftMult;
+  case WetlandClass::HardAvoid: return kHardMult;
+  case WetlandClass::None: return 1.0;
+  }
+  return 1.0;
+}
+
+void WetlandSidecar::SetElevationLookup(ElevationLookupFn fn) { g_elevLookup = fn; }
+
+bool WetlandSidecar::ElevationOverride(char const * mwmName, uint32_t featureId, uint32_t pointIdx,
+                                       int32_t & outAltitudeDm)
+{
+  if (!g_elevLookup || !mwmName || mwmName[0] == '\0')
+    return false;
+  return g_elevLookup(mwmName, featureId, pointIdx, &outAltitudeDm);
+}
+}  // namespace navi_spike
diff --git a/libs/routing/navi_wetland_cost.hpp b/libs/routing/navi_wetland_cost.hpp
new file mode 100644
index 000000000..2c20f1c4c
--- /dev/null
+++ b/libs/routing/navi_wetland_cost.hpp
@@ -0,0 +1,62 @@
+#pragma once
+// Navi wetland cost hook for CoMaps EdgeEstimator.
+// Lookups are supplied by the Navi FFI shim (Rust SidecarReader), not by
+// embedding a zstd/NVSC parser inside CoMaps.
+// SoftAvoid ×5 (weight/ETA); HardAvoid → enormous penalty (avoid).
+
+#include "routing/segment.hpp"
+
+#include <cstdint>
+
+namespace navi_spike
+{
+
+enum class WetlandClass : uint8_t
+{
+  None = 0,
+  SoftAvoid = 1,
+  HardAvoid = 2,
+};
+
+using WetlandLookupFn = WetlandClass (*)(uint32_t featureId, uint32_t segmentIdx, bool forward);
+
+/** Returns true when an EL02 override exists for this MWM leaf; altitude in decimetres.
+ *  `mwmName` is the CoMaps country/leaf id (e.g. "Norway_Oppland") — feature ids are
+ *  per-MWM and must not be looked up across leaves. */
+using ElevationLookupFn =
+    bool (*)(char const * mwmName, uint32_t featureId, uint32_t pointIdx, int32_t * outAltitudeDm);
+
+class WetlandSidecar
+{
+public:
+  // Install / clear the lookup provided by navi_comaps (Rust).
+  static void SetLookup(WetlandLookupFn fn);
+  static bool Enabled();
+  /** When false (default), bicycle estimator skips Soft/Hard. Foot always applies. */
+  static void SetBikeEnabled(bool enabled);
+  static bool BikeEnabled();
+  static WetlandClass Lookup(uint32_t featureId, uint32_t segmentIdx, bool forward);
+  static double CostMultiplier(WetlandClass c);
+
+  static void SetElevationLookup(ElevationLookupFn fn);
+  static bool ElevationOverride(char const * mwmName, uint32_t featureId, uint32_t pointIdx,
+                                int32_t & outAltitudeDm);
+};
+
+inline double ApplyWetlandCost(routing::Segment const & segment, double weightSeconds)
+{
+  if (!WetlandSidecar::Enabled())
+    return weightSeconds;
+  auto const cls = WetlandSidecar::Lookup(
+      segment.GetFeatureId(), segment.GetSegmentIdx(), segment.IsForward());
+  return weightSeconds * WetlandSidecar::CostMultiplier(cls);
+}
+
+inline double ApplyWetlandCostForBike(routing::Segment const & segment, double weightSeconds)
+{
+  if (!WetlandSidecar::BikeEnabled())
+    return weightSeconds;
+  return ApplyWetlandCost(segment, weightSeconds);
+}
+
+}  // namespace navi_spike
