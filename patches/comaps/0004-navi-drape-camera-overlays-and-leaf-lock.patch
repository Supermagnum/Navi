+void MyPositionController::NaviSetMode(location::EMyPositionMode target, ScreenBase const & screen)
+{
+  if (target != location::Follow && target != location::FollowAndRotate)
+    return;
+
+  m_desiredInitMode = target;
+  if (m_mode == location::NotFollowNoPosition)
+  {
+    ChangeMode(location::PendingPosition);
+    return;
+  }
+  if (!m_isPositionAssigned || m_mode == location::PendingPosition)
+    return;
+  if (m_mode == target)
+    return;
+
+  // Same zoom rule as NextMode(): from a country / world scale view zoom in to the position.
+  int preferredZoomLevel = kDoNotChangeZoom;
+  if (GetZoomLevel(screen) < kZoomThreshold)
+    preferredZoomLevel = std::min(GetZoomLevel(screen, m_position, m_errorRadius), kMaxScaleZoomLevel);
+
+  m_lastFollowMode = target;
+  ChangeMode(target, true);
+  if (target == location::Follow)
+  {
+    // North-up follow: also reset the rotation (as leaving follow-and-rotate does in NextMode()).
+    ChangeModelView(m_position, 0.0, m_visiblePixelRect.Center(), preferredZoomLevel);
+  }
+  else
+  {
+    UpdateViewport(preferredZoomLevel);
+  }
+}
