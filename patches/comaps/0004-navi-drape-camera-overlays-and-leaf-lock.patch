+// Camera ---------------------------------------------------------------------------------------
+
+// level < 0 keeps the current scale; a bearing outside +-720 keeps the current rotation. bearingDeg is the map
+// bearing (clockwise from north that points to the top of the screen).
+JNIEXPORT void JNICALL Java_app_organicmaps_sdk_NaviDrape_nativeSetCamera(JNIEnv *, jclass, jdouble lat, jdouble lon,
+                                                                         jdouble level, jdouble bearingDeg,
+                                                                         jboolean anim)
+{
+  auto * f = frm();
+  auto engine = f->GetDrapeEngine();
+  if (!engine)
+    return;
+  ScreenBase const & screen = f->GetCurrentModelView();
+  m2::RectD const px = screen.PixelRectIn3d();
+  if (px.SizeX() <= 0.0 || px.SizeY() <= 0.0)
+    return;
+  double const scale = level > 0.0 ? df::GetScreenScale(level) : screen.GetScale();
+  // CoMaps builds with -ffast-math, so NaN is not a usable "keep" sentinel: |bearing| > 720 keeps it.
+  bool const keepBearing = bearingDeg > 720.0 || bearingDeg < -720.0;
+  double const angle = keepBearing ? screen.GetAngle() : -ToRad(bearingDeg);
+  double const hw = px.SizeX() * 0.5 * scale;
+  double const hh = px.SizeY() * 0.5 * scale;
+  m2::AnyRectD const rect(mercator::FromLatLon(lat, lon), ang::AngleD(angle), m2::RectD(-hw, -hh, hw, hh));
+  engine->SetModelViewAnyRect(rect, anim, false /* useVisibleViewport */);
+}
+
+// [lat, lon, level, bearingDeg, pitchDeg, widthPx, heightPx, followMode]
+JNIEXPORT jdoubleArray JNICALL Java_app_organicmaps_sdk_NaviDrape_nativeGetCamera(JNIEnv * env, jclass)
+{
+  auto * f = frm();
+  ScreenBase const & s = f->GetCurrentModelView();
+  auto const ll = mercator::ToLatLon(s.GetOrg());
+  m2::RectD const px = s.PixelRectIn3d();
+  double const v[8] = {ll.m_lat,
+                       ll.m_lon,
+                       df::GetZoomLevel(s.GetScale()),
+                       -ToDeg(s.GetAngle()),
+                       s.isPerspective() ? ToDeg(s.GetRotationAngle()) : 0.0,
+                       px.SizeX(),
+                       px.SizeY(),
+                       g_framework && g_framework->IsDrapeEngineCreated()
+                           ? static_cast<double>(g_framework->GetMyPositionMode())
+                           : -1.0};
+  jdoubleArray arr = env->NewDoubleArray(8);
+  env->SetDoubleArrayRegion(arr, 0, 8, v);
+  return arr;
+}
+
+// Rotate to a map bearing (clockwise from north) about the visible centre; keeps a follow mode.
+JNIEXPORT void JNICALL Java_app_organicmaps_sdk_NaviDrape_nativeRotateTo(JNIEnv *, jclass, jdouble bearingDeg,
+                                                                        jboolean anim)
+{
+  frm()->Rotate(-ToRad(bearingDeg), anim);
+}
+
+// Fit a lat/lon box into the viewport (route overview).
+JNIEXPORT void JNICALL Java_app_organicmaps_sdk_NaviDrape_nativeFitRect(JNIEnv *, jclass, jdouble minLat,
+                                                                       jdouble minLon, jdouble maxLat,
+                                                                       jdouble maxLon, jboolean anim)
+{
+  m2::RectD rect;
+  rect.Add(mercator::FromLatLon(minLat, minLon));
+  rect.Add(mercator::FromLatLon(maxLat, maxLon));
+  rect.Scale(1.15);
+  frm()->ShowRect(rect, -1 /* maxScale */, anim);
+}
+
+// Relative zoom around the visible centre (keeps a follow mode, unlike nativeSetCamera).
+JNIEXPORT void JNICALL Java_app_organicmaps_sdk_NaviDrape_nativeScaleBy(JNIEnv *, jclass, jdouble factor,
+                                                                       jboolean anim)
+{
+  if (factor > 0.0)
+    frm()->Scale(factor, anim);
+}
+
+// mode: 0 = free (stop following), 1 = follow, 2 = follow and rotate (heading up).
+JNIEXPORT void JNICALL Java_app_organicmaps_sdk_NaviDrape_nativeSetFollowMode(JNIEnv *, jclass, jint mode)
+{
+  auto engine = frm()->GetDrapeEngine();
+  if (!engine)
+    return;
+  if (mode <= 0)
+    engine->StopLocationFollow();
+  else
+    engine->SetMyPositionFollowMode(mode >= 2);
+}
+
+// Navigation camera as the CoMaps app uses while following a route: puck lower on the screen,
+// perspective when 3D is allowed (Framework.nativeSet3dMode), heading-up from the GPS bearing.
+JNIEXPORT void JNICALL Java_app_organicmaps_sdk_NaviDrape_nativeSetNavigation(JNIEnv *, jclass, jboolean on,
+                                                                             jboolean pedestrian)
+{
+  auto engine = frm()->GetDrapeEngine();
+  if (!engine)
+    return;
+  if (on)
+  {
+    int const scale = pedestrian ? scales::GetPedestrianNavigationScale() : scales::GetNavigationScale();
+    int const scale3d = pedestrian ? scales::GetPedestrianNavigation3dScale() : scales::GetNavigation3dScale();
+    // allowRouteRotation=false: the arrow direction (GPS bearing) rotates the map; the route direction
+    // is only known to the CoMaps RoutingManager, which Navi does not drive.
+    engine->FollowRoute(scale, scale3d, false /* enableAutoZoom */, true /* isArrowGlued */,
+                        false /* allowRouteRotation */);
+  }
+  else
+  {
+    engine->DeactivateRouteFollowing();
+  }
+}
+
+JNIEXPORT void JNICALL Java_app_organicmaps_sdk_NaviDrape_nativeBlockTapEvents(JNIEnv *, jclass, jboolean block)
+{
+  frm()->BlockTapEvents(block);
+}
+
+// [lat, lon] under the pixel (x, y) of the current model view.
+JNIEXPORT jdoubleArray JNICALL Java_app_organicmaps_sdk_NaviDrape_nativeScreenToLatLon(JNIEnv * env, jclass, jfloat x,
+                                                                                      jfloat y)
+{
+  auto * f = frm();
+  auto const merc = f->P3dtoG(m2::PointD(x, y));
+  auto const ll = mercator::ToLatLon(merc);
+  double const v[2] = {ll.m_lat, ll.m_lon};
+  jdoubleArray arr = env->NewDoubleArray(2);
+  env->SetDoubleArrayRegion(arr, 0, 2, v);
+  return arr;
+}
+
+// Register leaf MWMs that appeared in the writable dir after the Framework was created.
+JNIEXPORT void JNICALL Java_app_organicmaps_sdk_NaviDrape_nativeRegisterMaps(JNIEnv *, jclass)
+{
+  if (g_framework)
+    g_framework->AddLocalMaps();
+}
+
+// CoMaps settings.ini string (e.g. PreferredGraphicsAPI = Vulkan | OpenGLES3).
+JNIEXPORT void JNICALL Java_app_organicmaps_sdk_NaviDrape_nativeSetSetting(JNIEnv * env, jclass, jstring jkey,
+                                                                          jstring jvalue)
+{
+  settings::Set(jni::ToNativeString(env, jkey), jni::ToNativeString(env, jvalue));
+}
+
+// Overlays -------------------------------------------------------------------------------------
+
+JNIEXPORT jlong JNICALL Java_app_organicmaps_sdk_NaviDrape_nativeCreateGroup(JNIEnv * env, jclass, jstring jname)
+{
+  auto & bm = frm()->GetBookmarkManager();
+  auto const id = bm.CreateBookmarkCategory(jni::ToNativeString(env, jname), false /* autoSave */);
+  bm.GetEditSession().SetIsVisible(id, true);
+  return static_cast<jlong>(id);
+}
+
+// Replace the content of a group with point marks. latlon = [lat0, lon0, lat1, lon1, ...];
+// icons are kml::BookmarkIcon values, colors kml::PredefinedColor values.
+JNIEXPORT void JNICALL Java_app_organicmaps_sdk_NaviDrape_nativeSetMarks(JNIEnv * env, jclass, jlong group,
+                                                                        jdoubleArray jlatlon, jobjectArray jnames,
+                                                                        jintArray jicons, jintArray jcolors)
+{
+  auto & bm = frm()->GetBookmarkManager();
+  auto es = bm.GetEditSession();
+  auto const gid = static_cast<kml::MarkGroupId>(group);
+  es.ClearGroup(gid);
+
+  jsize const n = env->GetArrayLength(jicons);
+  std::vector<double> latlon(static_cast<size_t>(n) * 2);
+  std::vector<jint> icons(static_cast<size_t>(n)), colors(static_cast<size_t>(n));
+  if (n > 0)
+  {
+    env->GetDoubleArrayRegion(jlatlon, 0, n * 2, latlon.data());
+    env->GetIntArrayRegion(jicons, 0, n, icons.data());
+    env->GetIntArrayRegion(jcolors, 0, n, colors.data());
+  }
+  for (jsize i = 0; i < n; ++i)
+  {
+    kml::BookmarkData data;
+    data.m_point = mercator::FromLatLon(latlon[2 * i], latlon[2 * i + 1]);
+    data.m_icon = static_cast<kml::BookmarkIcon>(icons[i]);
+    data.m_color.m_predefinedColor = static_cast<kml::PredefinedColor>(colors[i]);
+    data.m_visible = true;
+    jstring js = static_cast<jstring>(env->GetObjectArrayElement(jnames, i));
+    if (js)
+    {
+      kml::SetDefaultStr(data.m_name, jni::ToNativeString(env, js));
+      env->DeleteLocalRef(js);
+    }
+    es.CreateBookmark(std::move(data), gid);
+  }
+  es.SetIsVisible(gid, true);
+}
+
+// Replace the content of a group with polylines. counts[i] = number of points of line i; points are
+// flattened [lat, lon, ...]; argb[i] = 0xAARRGGBB; widths[i] in dp-ish pixels.
+JNIEXPORT void JNICALL Java_app_organicmaps_sdk_NaviDrape_nativeSetTracks(JNIEnv * env, jclass, jlong group,
+                                                                         jintArray jcounts, jdoubleArray jlatlon,
+                                                                         jintArray jargb, jfloatArray jwidths)
+{
+  auto & bm = frm()->GetBookmarkManager();
+  auto es = bm.GetEditSession();
+  auto const gid = static_cast<kml::MarkGroupId>(group);
+  es.ClearGroup(gid);
+
+  jsize const lines = env->GetArrayLength(jcounts);
+  if (lines == 0)
+    return;
+  std::vector<jint> counts(lines), argb(lines);
+  std::vector<jfloat> widths(lines);
+  env->GetIntArrayRegion(jcounts, 0, lines, counts.data());
+  env->GetIntArrayRegion(jargb, 0, lines, argb.data());
+  env->GetFloatArrayRegion(jwidths, 0, lines, widths.data());
+  jsize const total = env->GetArrayLength(jlatlon);
+  std::vector<double> latlon(total);
+  env->GetDoubleArrayRegion(jlatlon, 0, total, latlon.data());
+
+  size_t offset = 0;
+  for (jsize i = 0; i < lines; ++i)
+  {
+    size_t const cnt = static_cast<size_t>(std::max(0, counts[i]));
+    if (cnt < 2 || (offset + cnt) * 2 > static_cast<size_t>(total))
+    {
+      offset += cnt;
+      continue;
+    }
+    kml::TrackData td;
+    kml::MultiGeometry::LineT line;
+    line.reserve(cnt);
+    for (size_t k = 0; k < cnt; ++k)
+    {
+      auto const merc = mercator::FromLatLon(latlon[2 * (offset + k)], latlon[2 * (offset + k) + 1]);
+      line.emplace_back(merc, geometry::kInvalidAltitude);
+    }
+    offset += cnt;
+    td.m_geometry.m_lines.push_back(std::move(line));
+    kml::TrackLayer layer;
+    layer.m_lineWidth = widths[i];
+    uint32_t const c = static_cast<uint32_t>(argb[i]);
+    // kml colour is RGBA.
+    layer.m_color.m_rgba = ((c & 0x00FFFFFFu) << 8) | ((c >> 24) & 0xFFu);
+    td.m_layers.push_back(layer);
+    td.m_visible = true;
+    if (auto * track = es.CreateTrack(std::move(td)))
+      es.AttachTrack(track->GetId(), gid);
+  }
+  es.SetIsVisible(gid, true);
+}
+
+// Route line drawn by the drape's route renderer (CoMaps route style). type: 0 car, 1 pedestrian,
+// 2 bicycle. turnIdx = polyline point indices that get a turn arrow. Returns nothing; use
+// nativeClearRoute to remove every subroute added so far.
+JNIEXPORT void JNICALL Java_app_organicmaps_sdk_NaviDrape_nativeAddSubroute(JNIEnv * env, jclass,
+                                                                           jdoubleArray jlatlon, jint type,
+                                                                           jintArray jturnIdx)
+{
+  auto engine = frm()->GetDrapeEngine();
+  if (!engine)
+    return;
+  jsize const n2 = env->GetArrayLength(jlatlon);
+  size_t const n = static_cast<size_t>(n2 / 2);
+  if (n < 2)
+    return;
+  std::vector<double> latlon(n2);
+  env->GetDoubleArrayRegion(jlatlon, 0, n2, latlon.data());
+
+  std::vector<m2::PointD> pts;
+  pts.reserve(n);
+  std::vector<double> cum(n, 0.0);
+  for (size_t i = 0; i < n; ++i)
+  {
+    pts.push_back(mercator::FromLatLon(latlon[2 * i], latlon[2 * i + 1]));
+    if (i)
+      cum[i] = cum[i - 1] + pts[i].Length(pts[i - 1]);
+  }
+
+  auto subroute = std::make_shared<df::Subroute>();
+  subroute->m_baseDistance = 0.0;
+  subroute->m_baseDepthIndex = 0.0;
+  subroute->m_headFakeDistance = -1.0;
+  subroute->m_tailFakeDistance = cum.back() + 1.0;
+  subroute->m_polyline = m2::PolylineD(std::move(pts));
+  switch (type)
+  {
+  case 1:
+    subroute->m_routeType = df::RouteType::Pedestrian;
+    subroute->AddStyle(df::SubrouteStyle(df::kRoutePedestrian, df::RoutePattern(4.0, 2.0)));
+    break;
+  case 2:
+    subroute->m_routeType = df::RouteType::Bicycle;
+    subroute->AddStyle(df::SubrouteStyle(df::kRouteBicycle, df::RoutePattern(8.0, 2.0)));
+    break;
+  default:
+    subroute->m_routeType = df::RouteType::Car;
+    subroute->AddStyle(df::SubrouteStyle(df::kRouteColor, df::kRouteOutlineColor));
+    break;
+  }
+  if (jturnIdx)
+  {
+    jsize const tn = env->GetArrayLength(jturnIdx);
+    std::vector<jint> idx(tn);
+    env->GetIntArrayRegion(jturnIdx, 0, tn, idx.data());
+    for (jint k : idx)
+      if (k > 0 && static_cast<size_t>(k) < n)
+        subroute->m_turns.push_back(cum[static_cast<size_t>(k)]);
+  }
+  auto const id = engine->AddSubroute(df::SubrouteConstPtr(subroute));
+  std::lock_guard lock(g_routeMu);
+  g_subroutes.push_back(id);
+}
+
+JNIEXPORT void JNICALL Java_app_organicmaps_sdk_NaviDrape_nativeClearRoute(JNIEnv *, jclass)
+{
+  auto engine = frm()->GetDrapeEngine();
+  std::vector<dp::DrapeID> ids;
+  {
+    std::lock_guard lock(g_routeMu);
+    ids.swap(g_subroutes);
+  }
+  if (!engine)
+    return;
+  for (auto const id : ids)
+    engine->RemoveSubroute(id, false /* deactivateFollowing */);
+}
+
+// Start / intermediate / finish pins drawn as CoMaps route points. latlon = [lat, lon, ...] in
+// order start, vias..., finish; titles parallel. Empty arrays remove every route point.
+JNIEXPORT void JNICALL Java_app_organicmaps_sdk_NaviDrape_nativeSetRoutePoints(JNIEnv * env, jclass,
+                                                                              jdoubleArray jlatlon,
+                                                                              jobjectArray jtitles)
+{
+  auto & rm = frm()->GetRoutingManager();
+  rm.RemoveRoutePoints();
+  jsize const n2 = jlatlon ? env->GetArrayLength(jlatlon) : 0;
+  size_t const n = static_cast<size_t>(n2 / 2);
+  if (n == 0)
+    return;
+  std::vector<double> latlon(n2);
+  env->GetDoubleArrayRegion(jlatlon, 0, n2, latlon.data());
+  for (size_t i = 0; i < n; ++i)
+  {
+    RouteMarkData d;
+    d.m_position = mercator::FromLatLon(latlon[2 * i], latlon[2 * i + 1]);
+    if (i == 0)
+      d.m_pointType = RouteMarkType::Start;
+    else if (i + 1 == n)
+      d.m_pointType = RouteMarkType::Finish;
+    else
+    {
+      d.m_pointType = RouteMarkType::Intermediate;
+      d.m_intermediateIndex = i - 1;
+    }
+    if (jtitles && static_cast<jsize>(i) < env->GetArrayLength(jtitles))
+    {
+      jstring js = static_cast<jstring>(env->GetObjectArrayElement(jtitles, static_cast<jsize>(i)));
+      if (js)
+      {
+        d.m_title = jni::ToNativeString(env, js);
+        env->DeleteLocalRef(js);
+      }
+    }
+    d.m_isVisible = true;
+    rm.AddRoutePoint(std::move(d), false /* reorderIntermediatePoints */);
+  }
+}
+}  // extern "C"
