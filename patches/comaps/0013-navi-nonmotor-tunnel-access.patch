+        bool hasSidewalkType = false;
+        bool isPathHighway = false;
         for (uint32_t t : types)
         {
           if (IsHighwayTunnelType(t))
-          {
-            isTunnel = true;
-            break;
-          }
+            flags.isTunnel = true;
+          if (t == yesFoot)
+            hasYesFoot = true;
+          if (t == yesBicycle)
